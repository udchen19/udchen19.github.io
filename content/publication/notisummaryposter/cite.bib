author = {Wang, Peng-Jui and Lee, Yi-Chi and Chen, Uei-Dar and Chang, Yung-Ju},
title = {NotiSummary: Exploring the Potential of AI-Driven Text Summarization on Smartphone Notification Management},
year = {2023},
